# Copy this file to .env and fill in what you need.
# Everything here can also be set from the Accounts page in the app.

# Port the studio runs on (http://localhost:4747)
PORT=4747

# Public HTTPS address that forwards to this machine (ngrok, cloudflared, ...).
# TikTok and Instagram only accept HTTPS redirect URLs, so set this before connecting.
# Example: PUBLIC_URL=https://my-clips.ngrok-free.app
PUBLIC_URL=

# TikTok for Developers app (Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta app with "Instagram API with Instagram Login"
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v23.0
